{"version":1,"title":"Social Recall — 日本史ノート","source":{"name":"社会ノートs2t2m.pdf","pages":"ノート p.20–35","pdfPages":8,"note":"ノートに書き込まれた空欄と強調された重要語句をもとに学習用文章として再構成。手書きの判読や全ての下線の網羅は未保証。教科書タブとは独立した学習データです。"},"counts":{"total":357,"basic":299,"standard":357},"chapters":[{"id":"n01","title":"律令国家の変容","sections":[{"id":"n01a","title":"平安遷都と蝦夷（p.20）","pageStart":20,"pageEnd":20,"paragraphs":[{"id":"note-p20-01","page":20,"tokens":[{"id":"note:20:01:01","answer":"桓武天皇","level":1,"mark":"blank"},{"text":"は仏教勢力と旧都の政治的影響を避け、"},{"id":"note:20:01:02","answer":"長岡京","level":1,"mark":"blank"},{"text":"へ784年に遷都した。"},{"id":"note:20:01:03","answer":"藤原種継","level":1,"mark":"blank"},{"text":"暗殺事件などを経て、"},{"id":"note:20:01:04","answer":"平安京","level":1,"mark":"blank"},{"text":"へ"},{"id":"note:20:01:05","answer":"794年","level":1,"mark":"blank"},{"text":"に都を移した。"}]},{"id":"note-p20-02","page":20,"tokens":[{"text":"東北では780年に"},{"id":"note:20:02:01","answer":"伊治呰麻呂","level":1,"mark":"blank"},{"text":"が反乱を起こした。朝廷は"},{"id":"note:20:02:02","answer":"坂上田村麻呂","level":1,"mark":"blank"},{"text":"を"},{"id":"note:20:02:03","answer":"征夷大将軍","level":2,"mark":"underline"},{"text":"に任じ、"},{"id":"note:20:02:04","answer":"阿弖流為","level":1,"mark":"blank"},{"text":"らの降伏を受けた。支配の拠点として"},{"id":"note:20:02:05","answer":"胆沢城","level":1,"mark":"blank"},{"text":"を築き、その北方に"},{"id":"note:20:02:06","answer":"志波城","level":1,"mark":"blank"},{"text":"を置いた。"}]},{"id":"note-p20-03","page":20,"tokens":[{"text":"桓武朝は"},{"id":"note:20:03:01","answer":"健児","level":1,"mark":"blank"},{"text":"の制を採用し、従来の"},{"id":"note:20:03:02","answer":"軍団制","level":2,"mark":"underline"},{"text":"の見直しを進めた。また"},{"id":"note:20:03:03","answer":"勘解由使","level":1,"mark":"blank","explanation":"国司交代の際に前任者の政務を審査する令外官。"},{"text":"を設け、国司の交代を監督した。"}]},{"id":"note-p20-04","page":20,"tokens":[{"text":"律令の補充法は"},{"id":"note:20:04:01","answer":"格","level":1,"mark":"blank"},{"text":"、施行細則は"},{"id":"note:20:04:02","answer":"式","level":1,"mark":"blank"},{"text":"と呼ぶ。"},{"id":"note:20:04:03","answer":"三代格式","level":1,"mark":"blank"},{"text":"は"},{"id":"note:20:04:04","answer":"弘仁格式","level":2,"mark":"underline"},{"text":"・"},{"id":"note:20:04:05","answer":"貞観格式","level":2,"mark":"underline"},{"text":"・"},{"id":"note:20:04:06","answer":"延喜格式","level":2,"mark":"underline"},{"text":"の総称である。833年の"},{"id":"note:20:04:07","answer":"令義解","level":1,"mark":"blank"},{"text":"と、のちの"},{"id":"note:20:04:08","answer":"令集解","level":2,"mark":"underline"},{"text":"も混同しない。"}]},{"id":"note-p20-05","page":20,"tokens":[{"text":"地方では"},{"id":"note:20:05:01","answer":"偽籍","level":1,"mark":"blank"},{"text":"や浮浪・逃亡が増え、国家は"},{"id":"note:20:05:02","answer":"公営田","level":1,"mark":"blank"},{"text":"・"},{"id":"note:20:05:03","answer":"官田","level":1,"mark":"blank"},{"text":"などの経営によって財源を確保しようとした。皇族に与える田地は"},{"id":"note:20:05:04","answer":"賜田","level":1,"mark":"blank"},{"text":"、貴族の荘園経営にも変化が生まれた。"}]}]},{"id":"n01b","title":"唐風文化と平安仏教（p.21）","pageStart":21,"pageEnd":21,"paragraphs":[{"id":"note-p21-01","page":21,"tokens":[{"text":"平安初期の"},{"id":"note:21:01:01","answer":"弘仁・貞観文化","level":1,"mark":"blank"},{"text":"は、唐の影響を受けた"},{"id":"note:21:01:02","answer":"漢文学","level":2,"mark":"underline"},{"text":"と"},{"id":"note:21:01:03","answer":"密教","level":2,"mark":"underline"},{"text":"を特色とする。"},{"id":"note:21:01:04","answer":"六国史","level":1,"mark":"blank"},{"text":"は『日本書紀』から『日本三代実録』までの勅撰史書を指す。"}]},{"id":"note-p21-02","page":21,"tokens":[{"text":"勅撰漢詩集には"},{"id":"note:21:02:01","answer":"凌雲集","level":1,"mark":"blank"},{"text":"・"},{"id":"note:21:02:02","answer":"文華秀麗集","level":1,"mark":"blank"},{"text":"・"},{"id":"note:21:02:03","answer":"経国集","level":1,"mark":"blank"},{"text":"がある。"},{"id":"note:21:02:04","answer":"空海","level":2,"mark":"underline"},{"text":"の詩文には『性霊集』があり、最初の仏教説話集は"},{"id":"note:21:02:05","answer":"日本霊異記","level":1,"mark":"blank"},{"text":"である。"}]},{"id":"note-p21-03","page":21,"tokens":[{"text":"学問の場では"},{"id":"note:21:03:01","answer":"大学別曹","level":1,"mark":"blank"},{"text":"が有力氏族によって設けられ、和気氏の"},{"id":"note:21:03:02","answer":"弘文院","level":1,"mark":"blank"},{"text":"、藤原氏の"},{"id":"note:21:03:03","answer":"勧学院","level":1,"mark":"blank"},{"text":"などが知られる。空海は民衆にも開く"},{"id":"note:21:03:04","answer":"綜芸種智院","level":1,"mark":"blank"},{"text":"を設置した。"}]},{"id":"note-p21-04","page":21,"tokens":[{"id":"note:21:04:01","answer":"最澄","level":1,"mark":"blank"},{"text":"は"},{"id":"note:21:04:02","answer":"比叡山延暦寺","level":2,"mark":"underline"},{"text":"を拠点として"},{"id":"note:21:04:03","answer":"天台宗","level":1,"mark":"blank"},{"text":"を広めた。"},{"id":"note:21:04:04","answer":"空海","level":1,"mark":"blank"},{"text":"は"},{"id":"note:21:04:05","answer":"高野山金剛峯寺","level":2,"mark":"underline"},{"text":"を開き、"},{"id":"note:21:04:06","answer":"真言宗","level":1,"mark":"blank"},{"text":"を広めた。二人とも唐で仏教を学んだ。"}]},{"id":"note-p21-05","page":21,"tokens":[{"text":"密教では現世の利益を祈る"},{"id":"note:21:05:01","answer":"加持祈祷","level":1,"mark":"blank"},{"text":"が行われた。"},{"id":"note:21:05:02","answer":"神仏習合","level":1,"mark":"blank"},{"text":"が進み、神を仏の仮の姿とする"},{"id":"note:21:05:03","answer":"本地垂迹説","level":2,"mark":"underline"},{"text":"につながった。山岳修行と密教が結びついた"},{"id":"note:21:05:04","answer":"修験道","level":1,"mark":"blank"},{"text":"も発達した。"}]},{"id":"note-p21-06","page":21,"tokens":[{"text":"造形では"},{"id":"note:21:06:01","answer":"室生寺金堂","level":1,"mark":"blank"},{"text":"・"},{"id":"note:21:06:02","answer":"室生寺五重塔","level":2,"mark":"underline"},{"text":"、"},{"id":"note:21:06:03","answer":"東寺講堂","level":1,"mark":"blank"},{"text":"の立体曼荼羅が代表例である。"},{"id":"note:21:06:04","answer":"一木造","level":1,"mark":"blank"},{"text":"の仏像がつくられ、絵画では"},{"id":"note:21:06:05","answer":"両界曼荼羅","level":1,"mark":"blank"},{"text":"が重要である。書では嵯峨天皇・空海・橘逸勢を"},{"id":"note:21:06:06","answer":"三筆","level":1,"mark":"blank"},{"text":"という。"}]}]}]},{"id":"n02","title":"貴族政治と国風文化","sections":[{"id":"n02a","title":"摂関政治の成立（p.22）","pageStart":22,"pageEnd":22,"paragraphs":[{"id":"note-p22-01","page":22,"tokens":[{"id":"note:22:01:01","answer":"藤原冬嗣","level":1,"mark":"blank"},{"text":"は嵯峨天皇に仕え"},{"id":"note:22:01:02","answer":"蔵人頭","level":1,"mark":"blank"},{"text":"となり、"},{"id":"note:22:01:03","answer":"閑院","level":2,"mark":"underline"},{"text":"系の発展の基礎を築いた。"},{"id":"note:22:01:04","answer":"藤原良房","level":1,"mark":"blank"},{"text":"は"},{"id":"note:22:01:05","answer":"承和の変","level":1,"mark":"blank"},{"text":"（842年）を経て勢力を伸ばし、858年に"},{"id":"note:22:01:06","answer":"摂政","level":1,"mark":"blank"},{"text":"となった。"}]},{"id":"note-p22-02","page":22,"tokens":[{"id":"note:22:02:01","answer":"応天門の変","level":1,"mark":"blank"},{"text":"（866年）の後、良房は政界での影響力を強めた。養子の"},{"id":"note:22:02:02","answer":"藤原基経","level":1,"mark":"blank"},{"text":"は"},{"id":"note:22:02:03","answer":"阿衡の紛議","level":1,"mark":"blank"},{"text":"（888年）を経て"},{"id":"note:22:02:04","answer":"関白","level":1,"mark":"blank"},{"text":"の地位を確立した。"}]},{"id":"note-p22-03","page":22,"tokens":[{"id":"note:22:03:01","answer":"藤原時平","level":1,"mark":"blank"},{"text":"は宇多天皇期の改革を受け継ぐ立場にあったが、901年に"},{"id":"note:22:03:02","answer":"菅原道真","level":1,"mark":"blank"},{"text":"が左遷された。この事件を"},{"id":"note:22:03:03","answer":"昌泰の変","level":1,"mark":"blank"},{"text":"と呼び、道真は"},{"id":"note:22:03:04","answer":"大宰府","level":2,"mark":"underline"},{"text":"へ送られた。"}]},{"id":"note-p22-04","page":22,"tokens":[{"text":"延喜の治は"},{"id":"note:22:04:01","answer":"醍醐天皇","level":1,"mark":"blank"},{"text":"、天暦の治は"},{"id":"note:22:04:02","answer":"村上天皇","level":1,"mark":"blank"},{"text":"の時期である。"},{"id":"note:22:04:03","answer":"藤原実頼","level":1,"mark":"blank"},{"text":"が安和の変（"},{"id":"note:22:04:04","answer":"969年","level":1,"mark":"blank"},{"text":"）ののち政治の主導権を握り、他氏排斥が進んだ。"}]},{"id":"note-p22-05","page":22,"tokens":[{"id":"note:22:05:01","answer":"藤原道長","level":1,"mark":"blank"},{"text":"は"},{"id":"note:22:05:02","answer":"内覧","level":2,"mark":"underline"},{"text":"を務め、1016年に"},{"id":"note:22:05:03","answer":"摂政","level":1,"mark":"blank"},{"text":"となった。道長の栄華を示す詩は『"},{"id":"note:22:05:04","answer":"小右記","level":1,"mark":"blank"},{"text":"』にも見え、同時代史料として『"},{"id":"note:22:05:05","answer":"御堂関白記","level":2,"mark":"underline"},{"text":"』が重要である。"}]},{"id":"note-p22-06","page":22,"tokens":[{"text":"道長の子"},{"id":"note:22:06:01","answer":"藤原頼通","level":1,"mark":"blank"},{"text":"は"},{"id":"note:22:06:02","answer":"平等院","level":1,"mark":"blank"},{"text":"を建立した。地方政治は"},{"id":"note:22:06:03","answer":"受領","level":2,"mark":"underline"},{"text":"に委ねられ、中央では"},{"id":"note:22:06:04","answer":"陣定","level":1,"mark":"blank"},{"text":"などの公卿会議を通じて政務が行われた。"}]},{"id":"note-p22-07","page":22,"tokens":[{"text":"唐への正式な遣使は"},{"id":"note:22:07:01","answer":"894年","level":1,"mark":"blank"},{"text":"に"},{"id":"note:22:07:02","answer":"菅原道真","level":1,"mark":"blank"},{"text":"の建議を受けて停止された。その後も"},{"id":"note:22:07:03","answer":"宋商人","level":2,"mark":"underline"},{"text":"などを通じた交流は続いた。"}]}]},{"id":"n02b","title":"国風文化（p.23）","pageStart":23,"pageEnd":23,"paragraphs":[{"id":"note-p23-01","page":23,"tokens":[{"id":"note:23:01:01","answer":"国風文化","level":1,"mark":"blank"},{"text":"は平安中期に発達し、"},{"id":"note:23:01:02","answer":"かな文字","level":2,"mark":"underline"},{"text":"の普及によって和歌や物語などの文学が広がった。"}]},{"id":"note-p23-02","page":23,"tokens":[{"text":"勅撰和歌集の最初は"},{"id":"note:23:02:01","answer":"古今和歌集","level":1,"mark":"blank"},{"text":"で、"},{"id":"note:23:02:02","answer":"紀貫之","level":1,"mark":"blank"},{"text":"らが編纂した。紀貫之は仮名による日記『"},{"id":"note:23:02:03","answer":"土佐日記","level":1,"mark":"blank"},{"text":"』も残した。"}]},{"id":"note-p23-03","page":23,"tokens":[{"text":"物語では『"},{"id":"note:23:03:01","answer":"竹取物語","level":1,"mark":"blank"},{"text":"』が最古の物語とされ、『"},{"id":"note:23:03:02","answer":"伊勢物語","level":1,"mark":"blank"},{"text":"』は"},{"id":"note:23:03:03","answer":"歌物語","level":2,"mark":"underline"},{"text":"である。紫式部の『"},{"id":"note:23:03:04","answer":"源氏物語","level":1,"mark":"blank"},{"text":"』、清少納言の『"},{"id":"note:23:03:05","answer":"枕草子","level":1,"mark":"blank"},{"text":"』も重要である。"}]},{"id":"note-p23-04","page":23,"tokens":[{"text":"仮名文学には『"},{"id":"note:23:04:01","answer":"蜻蛉日記","level":1,"mark":"blank"},{"text":"』『"},{"id":"note:23:04:02","answer":"更級日記","level":1,"mark":"blank"},{"text":"』『"},{"id":"note:23:04:03","answer":"和泉式部日記","level":1,"mark":"blank"},{"text":"』などがある。"},{"id":"note:23:04:04","answer":"枕草子","level":1,"mark":"blank"},{"text":"は随筆で、"},{"id":"note:23:04:05","answer":"中宮定子","level":2,"mark":"underline"},{"text":"に仕えた清少納言が著した。"}]},{"id":"note-p23-05","page":23,"tokens":[{"text":"神仏習合を背景に"},{"id":"note:23:05:01","answer":"本地垂迹説","level":1,"mark":"blank"},{"text":"が広まり、"},{"id":"note:23:05:02","answer":"御霊信仰","level":2,"mark":"underline"},{"text":"や"},{"id":"note:23:05:03","answer":"陰陽道","level":2,"mark":"underline"},{"text":"も人々の生活に関わった。10世紀半ばには"},{"id":"note:23:05:04","answer":"空也","level":1,"mark":"blank"},{"text":"が念仏を広め、"},{"id":"note:23:05:05","answer":"源信","level":1,"mark":"blank"},{"text":"は『"},{"id":"note:23:05:06","answer":"往生要集","level":1,"mark":"blank"},{"text":"』を著した。"}]},{"id":"note-p23-06","page":23,"tokens":[{"text":"建築では"},{"id":"note:23:06:01","answer":"寝殿造","level":1,"mark":"blank"},{"text":"が貴族の邸宅様式として発達し、"},{"id":"note:23:06:02","answer":"平等院鳳凰堂","level":1,"mark":"blank"},{"text":"は"},{"id":"note:23:06:03","answer":"阿弥陀堂","level":2,"mark":"underline"},{"text":"の代表例である。絵画は"},{"id":"note:23:06:04","answer":"大和絵","level":1,"mark":"blank"},{"text":"、書は"},{"id":"note:23:06:05","answer":"三蹟","level":1,"mark":"blank"},{"text":"（小野道風・藤原佐理・藤原行成）が知られる。"}]},{"id":"note-p23-07","page":23,"tokens":[{"text":"彫刻では"},{"id":"note:23:07:01","answer":"定朝","level":1,"mark":"blank"},{"text":"が確立した"},{"id":"note:23:07:02","answer":"寄木造","level":1,"mark":"blank"},{"text":"が重要で、平等院鳳凰堂の"},{"id":"note:23:07:03","answer":"阿弥陀如来坐像","level":2,"mark":"underline"},{"text":"に見られる。"}]},{"id":"note-p23-08","page":23,"tokens":[{"text":"貴族の衣装には男性の"},{"id":"note:23:08:01","answer":"束帯","level":1,"mark":"blank"},{"text":"・"},{"id":"note:23:08:02","answer":"直衣","level":2,"mark":"underline"},{"text":"、女性の"},{"id":"note:23:08:03","answer":"女房装束","level":1,"mark":"blank"},{"text":"（十二単）がある。儀式・慣習は"},{"id":"note:23:08:04","answer":"年中行事","level":2,"mark":"underline"},{"text":"として整理された。"}]}]},{"id":"n02c","title":"受領・荘園の発達（p.24）","pageStart":24,"pageEnd":24,"paragraphs":[{"id":"note-p24-01","page":24,"tokens":[{"id":"note:24:01:01","answer":"三善清行","level":1,"mark":"blank"},{"text":"は"},{"id":"note:24:01:02","answer":"意見十二箇条","level":1,"mark":"blank"},{"text":"（914年）で地方政治の乱れを指摘した。902年の"},{"id":"note:24:01:03","answer":"延喜の荘園整理令","level":1,"mark":"blank"},{"text":"も、増大する土地支配の問題に対応しようとした。"}]},{"id":"note-p24-02","page":24,"tokens":[{"text":"土地に対する課税は、人身単位から土地単位へ移った。国司は公田を"},{"id":"note:24:02:01","answer":"名","level":1,"mark":"blank"},{"text":"に編成し、有力な農民である"},{"id":"note:24:02:02","answer":"田堵","level":1,"mark":"blank"},{"text":"に耕作と納税を請け負わせた。"}]},{"id":"note-p24-03","page":24,"tokens":[{"text":"一国の行政・租税徴収を担当する"},{"id":"note:24:03:01","answer":"受領","level":1,"mark":"blank"},{"text":"は大きな権限を持った。地方の収益を求める受領と農民の対立は、"},{"id":"note:24:03:02","answer":"尾張国郡司百姓等解","level":1,"mark":"blank"},{"text":"などに表れている。"}]},{"id":"note-p24-04","page":24,"tokens":[{"text":"土地を私的に開発した"},{"id":"note:24:04:01","answer":"開発領主","level":1,"mark":"blank"},{"text":"は、有力貴族や寺社へ"},{"id":"note:24:04:02","answer":"寄進","level":1,"mark":"blank"},{"text":"して保護を得た。このように成立した荘園を"},{"id":"note:24:04:03","answer":"寄進地系荘園","level":1,"mark":"blank"},{"text":"という。"}]},{"id":"note-p24-05","page":24,"tokens":[{"text":"荘園の権利者には"},{"id":"note:24:05:01","answer":"本家","level":1,"mark":"blank"},{"text":"・"},{"id":"note:24:05:02","answer":"領家","level":1,"mark":"blank"},{"text":"があり、現地管理には"},{"id":"note:24:05:03","answer":"荘官","level":1,"mark":"blank"},{"text":"が当たった。国衙との関係では"},{"id":"note:24:05:04","answer":"不輸の権","level":1,"mark":"blank"},{"text":"（租税免除）、"},{"id":"note:24:05:05","answer":"不入の権","level":1,"mark":"blank"},{"text":"（国司の立入拒否）が重要である。"}]}]},{"id":"n02d","title":"武士の成立（p.25）","pageStart":25,"pageEnd":25,"paragraphs":[{"id":"note-p25-01","page":25,"tokens":[{"text":"地方政治が乱れると、武装した有力農民や官人が"},{"id":"note:25:01:01","answer":"武士","level":1,"mark":"blank"},{"text":"へ成長し、"},{"id":"note:25:01:02","answer":"家子","level":1,"mark":"blank"},{"text":"・"},{"id":"note:25:01:03","answer":"郎党","level":1,"mark":"blank"},{"text":"を率いて国司に抵抗することもあった。"}]},{"id":"note-p25-02","page":25,"tokens":[{"text":"関東では"},{"id":"note:25:02:01","answer":"平将門","level":1,"mark":"blank"},{"text":"が反乱を起こし、自らを"},{"id":"note:25:02:02","answer":"新皇","level":1,"mark":"blank"},{"text":"と称した（"},{"id":"note:25:02:03","answer":"939年","level":1,"mark":"blank"},{"text":"）。朝廷側の"},{"id":"note:25:02:04","answer":"平貞盛","level":1,"mark":"blank"},{"text":"・"},{"id":"note:25:02:05","answer":"藤原秀郷","level":1,"mark":"blank"},{"text":"らが討伐した。"}]},{"id":"note-p25-03","page":25,"tokens":[{"text":"瀬戸内海では"},{"id":"note:25:03:01","answer":"藤原純友","level":1,"mark":"blank"},{"text":"が海賊を率いて反乱を起こした。両者をあわせて"},{"id":"note:25:03:02","answer":"承平・天慶の乱","level":1,"mark":"blank"},{"text":"と呼ぶ。"}]},{"id":"note-p25-04","page":25,"tokens":[{"text":"中央政府は"},{"id":"note:25:04:01","answer":"検非違使","level":1,"mark":"blank"},{"text":"や"},{"id":"note:25:04:02","answer":"滝口の武者","level":1,"mark":"blank"},{"text":"を警備に用い、地方の武士はやがて"},{"id":"note:25:04:03","answer":"武士団","level":1,"mark":"blank"},{"text":"を形成した。"}]},{"id":"note-p25-05","page":25,"tokens":[{"id":"note:25:05:01","answer":"源頼光","level":1,"mark":"blank"},{"text":"は藤原道長に仕え、"},{"id":"note:25:05:02","answer":"源頼信","level":1,"mark":"blank"},{"text":"は平忠常の乱に対応した。"},{"id":"note:25:05:03","answer":"前九年合戦","level":1,"mark":"blank"},{"text":"や"},{"id":"note:25:05:04","answer":"後三年合戦","level":1,"mark":"blank"},{"text":"を経て"},{"id":"note:25:05:05","answer":"源義家","level":1,"mark":"blank"},{"text":"が東国武士と結びつきを強めた。"}]},{"id":"note-p25-06","page":25,"tokens":[{"text":"平氏では"},{"id":"note:25:06:01","answer":"平忠常の乱","level":1,"mark":"blank"},{"text":"（1028年）、"},{"id":"note:25:06:02","answer":"刀伊の入寇","level":1,"mark":"blank"},{"text":"（1019年）などの事件もこの時期に起こった。"},{"id":"note:25:06:03","answer":"藤原隆家","level":2,"mark":"underline"},{"text":"は刀伊の入寇に対応した。"}]}]}]},{"id":"n03","title":"院政と平氏政権","sections":[{"id":"n03a","title":"院政の始まり（p.26）","pageStart":26,"pageEnd":26,"paragraphs":[{"id":"note-p26-01","page":26,"tokens":[{"id":"note:26:01:01","answer":"後三条天皇","level":1,"mark":"blank"},{"text":"は摂関家を外戚とせず即位し、"},{"id":"note:26:01:02","answer":"1069年","level":1,"mark":"blank"},{"text":"に"},{"id":"note:26:01:03","answer":"延久の荘園整理令","level":1,"mark":"blank"},{"text":"を出した。審査機関として"},{"id":"note:26:01:04","answer":"記録荘園券契所","level":1,"mark":"blank"},{"text":"を設けた。"}]},{"id":"note-p26-02","page":26,"tokens":[{"id":"note:26:02:01","answer":"白河上皇","level":1,"mark":"blank"},{"text":"は1086年に"},{"id":"note:26:02:02","answer":"院政","level":1,"mark":"blank"},{"text":"を始めた。上皇の側近は"},{"id":"note:26:02:03","answer":"院司","level":1,"mark":"blank"},{"text":"、命令文書には"},{"id":"note:26:02:04","answer":"院宣","level":1,"mark":"blank"},{"text":"がある。院の命令を支える武力として"},{"id":"note:26:02:05","answer":"北面の武士","level":1,"mark":"blank"},{"text":"を置いた。"}]},{"id":"note-p26-03","page":26,"tokens":[{"text":"院政期は"},{"id":"note:26:03:01","answer":"知行国","level":1,"mark":"blank"},{"text":"が広まり、上皇や貴族による地方収益の掌握が進んだ。国衙に属する土地を"},{"id":"note:26:03:02","answer":"公領","level":1,"mark":"blank"},{"text":"、有力者に寄進されて支配される土地を"},{"id":"note:26:03:03","answer":"荘園","level":2,"mark":"underline"},{"text":"と呼ぶ。"}]},{"id":"note-p26-04","page":26,"tokens":[{"text":"荘園・公領では"},{"id":"note:26:04:01","answer":"名田","level":1,"mark":"blank"},{"text":"を基礎に年貢を徴収し、"},{"id":"note:26:04:02","answer":"名主","level":1,"mark":"blank"},{"text":"が耕作を担った。農民は"},{"id":"note:26:04:03","answer":"年貢","level":1,"mark":"blank"},{"text":"のほか"},{"id":"note:26:04:04","answer":"公事","level":1,"mark":"blank"},{"text":"や"},{"id":"note:26:04:05","answer":"夫役","level":1,"mark":"blank"},{"text":"を負った。"}]},{"id":"note-p26-05","page":26,"tokens":[{"text":"東北では"},{"id":"note:26:05:01","answer":"前九年合戦","level":1,"mark":"blank"},{"text":"（1051〜62年）と"},{"id":"note:26:05:02","answer":"後三年合戦","level":1,"mark":"blank"},{"text":"（1083〜87年）が発生した。"},{"id":"note:26:05:03","answer":"源頼義","level":1,"mark":"blank"},{"text":"・"},{"id":"note:26:05:04","answer":"源義家","level":1,"mark":"blank"},{"text":"が戦い、"},{"id":"note:26:05:05","answer":"藤原清衡","level":1,"mark":"blank"},{"text":"が奥州藤原氏の発展の基礎を築いた。"}]},{"id":"note-p26-06","page":26,"tokens":[{"text":"上皇や貴族は寺社を保護し、"},{"id":"note:26:06:01","answer":"六勝寺","level":1,"mark":"blank"},{"text":"などを建立した。白河上皇の造営した"},{"id":"note:26:06:02","answer":"法勝寺","level":1,"mark":"blank"},{"text":"はその代表である。"}]}]},{"id":"n03b","title":"保元・平治の乱と平氏（p.27）","pageStart":27,"pageEnd":27,"paragraphs":[{"id":"note-p27-01","page":27,"tokens":[{"text":"院政が進むと"},{"id":"note:27:01:01","answer":"院近臣","level":1,"mark":"blank"},{"text":"や"},{"id":"note:27:01:02","answer":"知行国主","level":1,"mark":"blank"},{"text":"が実権を持つようになり、既存の貴族秩序と競合した。寺社勢力は"},{"id":"note:27:01:03","answer":"僧兵","level":1,"mark":"blank"},{"text":"を組織して強訴した。"}]},{"id":"note-p27-02","page":27,"tokens":[{"text":"延暦寺の僧兵を"},{"id":"note:27:02:01","answer":"山法師","level":2,"mark":"underline"},{"text":"、興福寺の僧兵を"},{"id":"note:27:02:02","answer":"奈良法師","level":2,"mark":"underline"},{"text":"とも呼ぶ。奥州藤原氏は"},{"id":"note:27:02:03","answer":"平泉","level":1,"mark":"blank"},{"text":"を拠点として、"},{"id":"note:27:02:04","answer":"中尊寺","level":2,"mark":"underline"},{"text":"などの造営を進めた。"}]},{"id":"note-p27-03","page":27,"tokens":[{"id":"note:27:03:01","answer":"保元の乱","level":1,"mark":"blank"},{"text":"（1156年）では"},{"id":"note:27:03:02","answer":"崇徳上皇","level":2,"mark":"underline"},{"text":"側と"},{"id":"note:27:03:03","answer":"後白河天皇","level":2,"mark":"underline"},{"text":"側が争い、後白河側に加わった"},{"id":"note:27:03:04","answer":"平清盛","level":1,"mark":"blank"},{"text":"・"},{"id":"note:27:03:05","answer":"源義朝","level":1,"mark":"blank"},{"text":"らが勝利した。"}]},{"id":"note-p27-04","page":27,"tokens":[{"id":"note:27:04:01","answer":"平治の乱","level":1,"mark":"blank"},{"text":"（1159年）では平清盛が"},{"id":"note:27:04:02","answer":"源義朝","level":1,"mark":"blank"},{"text":"を破り、平氏の優位が決定的になった。"}]},{"id":"note-p27-05","page":27,"tokens":[{"text":"平清盛は1167年に武士で初めて"},{"id":"note:27:05:01","answer":"太政大臣","level":1,"mark":"blank"},{"text":"となり、"},{"id":"note:27:05:02","answer":"六波羅","level":1,"mark":"blank"},{"text":"を拠点に政権を運営した。"},{"id":"note:27:05:03","answer":"大輪田泊","level":1,"mark":"blank"},{"text":"を整備し、"},{"id":"note:27:05:04","answer":"日宋貿易","level":1,"mark":"blank"},{"text":"を進めた。"}]},{"id":"note-p27-06","page":27,"tokens":[{"text":"宋からは"},{"id":"note:27:06:01","answer":"宋銭","level":1,"mark":"blank"},{"text":"・陶磁器・書籍などが輸入され、対外交易とともに平氏政権の財政基盤が強化された。"}]}]},{"id":"n03c","title":"院政期の文化（p.28）","pageStart":28,"pageEnd":28,"paragraphs":[{"id":"note-p28-01","page":28,"tokens":[{"text":"院政期には"},{"id":"note:28:01:01","answer":"今様","level":1,"mark":"blank"},{"text":"が流行し、後白河上皇は歌謡集『"},{"id":"note:28:01:02","answer":"梁塵秘抄","level":1,"mark":"blank"},{"text":"』を編んだ。"},{"id":"note:28:01:03","answer":"田楽","level":2,"mark":"underline"},{"text":"・"},{"id":"note:28:01:04","answer":"猿楽","level":2,"mark":"underline"},{"text":"などの芸能も広まった。"}]},{"id":"note-p28-02","page":28,"tokens":[{"text":"説話集には『"},{"id":"note:28:02:01","answer":"今昔物語集","level":1,"mark":"blank"},{"text":"』、歴史物語には『"},{"id":"note:28:02:02","answer":"大鏡","level":1,"mark":"blank"},{"text":"』、軍記物語には『"},{"id":"note:28:02:03","answer":"将門記","level":1,"mark":"blank"},{"text":"』『"},{"id":"note:28:02:04","answer":"陸奥話記","level":1,"mark":"blank"},{"text":"』などがある。"}]},{"id":"note-p28-03","page":28,"tokens":[{"text":"建築では"},{"id":"note:28:03:01","answer":"中尊寺金色堂","level":1,"mark":"blank"},{"text":"が"},{"id":"note:28:03:02","answer":"藤原清衡","level":2,"mark":"underline"},{"text":"により建立され、仏堂では"},{"id":"note:28:03:03","answer":"阿弥陀信仰","level":2,"mark":"underline"},{"text":"が強く反映された。"}]},{"id":"note-p28-04","page":28,"tokens":[{"text":"絵巻では『"},{"id":"note:28:04:01","answer":"源氏物語絵巻","level":1,"mark":"blank"},{"text":"』『"},{"id":"note:28:04:02","answer":"伴大納言絵巻","level":1,"mark":"blank"},{"text":"』『"},{"id":"note:28:04:03","answer":"信貴山縁起絵巻","level":1,"mark":"blank"},{"text":"』『"},{"id":"note:28:04:04","answer":"鳥獣人物戯画","level":1,"mark":"blank"},{"text":"』を区別する。"}]},{"id":"note-p28-05","page":28,"tokens":[{"text":"装飾経には"},{"id":"note:28:05:01","answer":"扇面法華経冊子","level":1,"mark":"blank"},{"text":"や"},{"id":"note:28:05:02","answer":"平家納経","level":1,"mark":"blank"},{"text":"がある。和様の発展と宋文化からの影響が並行して見られる。"}]}]},{"id":"n03d","title":"古代文化の整理（p.29）","pageStart":29,"pageEnd":29,"paragraphs":[{"id":"note-p29-01","page":29,"tokens":[{"text":"文化史を整理すると、唐風の弘仁・貞観文化から、かな文学と浄土信仰を特色とする国風文化へと移った。"}]},{"id":"note-p29-02","page":29,"tokens":[{"text":"院政期に流行した今様・田楽と、絵巻物の発展は、貴族以外の社会を描く文化の広がりを示す。"}]},{"id":"note-p29-03","page":29,"tokens":[{"text":"最澄・空海による密教、源信らの浄土教、神仏習合が各時期の宗教的特色を表している。"}]}]}]},{"id":"n04","title":"鎌倉幕府と武士社会","sections":[{"id":"n04a","title":"鎌倉幕府の成立（p.30）","pageStart":30,"pageEnd":30,"paragraphs":[{"id":"note-p30-01","page":30,"tokens":[{"id":"note:30:01:01","answer":"鹿ケ谷の陰謀","level":1,"mark":"blank"},{"text":"（1177年）は平氏打倒計画が発覚した事件である。1180年に"},{"id":"note:30:01:02","answer":"以仁王の令旨","level":1,"mark":"blank"},{"text":"を受け"},{"id":"note:30:01:03","answer":"源頼政","level":1,"mark":"blank"},{"text":"らが挙兵した。"}]},{"id":"note-p30-02","page":30,"tokens":[{"id":"note:30:02:01","answer":"源頼朝","level":1,"mark":"blank"},{"text":"は伊豆で挙兵し、"},{"id":"note:30:02:02","answer":"鎌倉","level":1,"mark":"blank"},{"text":"を拠点とした。"},{"id":"note:30:02:03","answer":"石橋山の戦い","level":1,"mark":"blank"},{"text":"に敗れた後、房総から再起した。"}]},{"id":"note-p30-03","page":30,"tokens":[{"id":"note:30:03:01","answer":"源義仲","level":1,"mark":"blank"},{"text":"は1183年に入京したが、"},{"id":"note:30:03:02","answer":"源義経","level":1,"mark":"blank"},{"text":"らに敗れた。源義経は"},{"id":"note:30:03:03","answer":"一ノ谷","level":1,"mark":"blank"},{"text":"・"},{"id":"note:30:03:04","answer":"屋島","level":1,"mark":"blank"},{"text":"・"},{"id":"note:30:03:05","answer":"壇ノ浦","level":1,"mark":"blank"},{"text":"の戦いで平氏を追い、"},{"id":"note:30:03:06","answer":"1185年","level":1,"mark":"blank"},{"text":"に平氏は滅亡した。"}]},{"id":"note-p30-04","page":30,"tokens":[{"text":"頼朝は"},{"id":"note:30:04:01","answer":"守護","level":1,"mark":"blank"},{"text":"・"},{"id":"note:30:04:02","answer":"地頭","level":1,"mark":"blank"},{"text":"の設置を認められ、1192年に"},{"id":"note:30:04:03","answer":"征夷大将軍","level":1,"mark":"blank"},{"text":"となった。1189年には"},{"id":"note:30:04:04","answer":"奥州藤原氏","level":1,"mark":"blank"},{"text":"を滅ぼした。"}]},{"id":"note-p30-05","page":30,"tokens":[{"text":"幕府の中枢には"},{"id":"note:30:05:01","answer":"政所","level":1,"mark":"blank"},{"text":"（政務）、"},{"id":"note:30:05:02","answer":"問注所","level":1,"mark":"blank"},{"text":"（訴訟）、"},{"id":"note:30:05:03","answer":"侍所","level":1,"mark":"blank"},{"text":"（御家人統制）が置かれた。地方には"},{"id":"note:30:05:04","answer":"京都守護","level":1,"mark":"blank"},{"text":"・"},{"id":"note:30:05:05","answer":"鎮西奉行","level":1,"mark":"blank"},{"text":"や、のちの"},{"id":"note:30:05:06","answer":"六波羅探題","level":1,"mark":"blank"},{"text":"が重要である。"}]}]},{"id":"n04b","title":"御家人と執権政治（p.31）","pageStart":31,"pageEnd":31,"paragraphs":[{"id":"note-p31-01","page":31,"tokens":[{"text":"将軍と"},{"id":"note:31:01:01","answer":"御家人","level":1,"mark":"blank"},{"text":"は"},{"id":"note:31:01:02","answer":"御恩","level":1,"mark":"blank"},{"text":"と"},{"id":"note:31:01:03","answer":"奉公","level":1,"mark":"blank"},{"text":"で結ばれた。御恩には所領の保護である"},{"id":"note:31:01:04","answer":"本領安堵","level":1,"mark":"blank"},{"text":"、新しい所領を与える"},{"id":"note:31:01:05","answer":"新恩給与","level":1,"mark":"blank"},{"text":"がある。"}]},{"id":"note-p31-02","page":31,"tokens":[{"text":"奉公は"},{"id":"note:31:02:01","answer":"軍役","level":1,"mark":"blank"},{"text":"や"},{"id":"note:31:02:02","answer":"京都大番役","level":1,"mark":"blank"},{"text":"などの役務を果たすことをいう。"},{"id":"note:31:02:03","answer":"御家人","level":2,"mark":"underline"},{"text":"が所領を基盤として幕府を支えた。"}]},{"id":"note-p31-03","page":31,"tokens":[{"id":"note:31:03:01","answer":"北条時政","level":1,"mark":"blank"},{"text":"は"},{"id":"note:31:03:02","answer":"初代執権","level":2,"mark":"underline"},{"text":"、"},{"id":"note:31:03:03","answer":"北条義時","level":1,"mark":"blank"},{"text":"は"},{"id":"note:31:03:04","answer":"二代執権","level":2,"mark":"underline"},{"text":"である。"},{"id":"note:31:03:05","answer":"和田合戦","level":1,"mark":"blank"},{"text":"（1213年）を経て義時の権力が強まった。"}]},{"id":"note-p31-04","page":31,"tokens":[{"id":"note:31:04:01","answer":"承久の乱","level":1,"mark":"blank"},{"text":"（1221年）では"},{"id":"note:31:04:02","answer":"後鳥羽上皇","level":1,"mark":"blank"},{"text":"が討幕を図るも敗北した。幕府は京都に"},{"id":"note:31:04:03","answer":"六波羅探題","level":1,"mark":"blank"},{"text":"を置き、上皇方の所領を没収した。"}]},{"id":"note-p31-05","page":31,"tokens":[{"text":"幕府は"},{"id":"note:31:05:01","answer":"新補地頭","level":1,"mark":"blank"},{"text":"を新たに任命し、"},{"id":"note:31:05:02","answer":"新補率法","level":1,"mark":"blank"},{"text":"などを適用した。"},{"id":"note:31:05:03","answer":"北条政子","level":2,"mark":"underline"},{"text":"の演説は御家人の結束を促した。"}]}]},{"id":"n04c","title":"武家法と土地支配（p.32）","pageStart":32,"pageEnd":32,"paragraphs":[{"id":"note-p32-01","page":32,"tokens":[{"id":"note:32:01:01","answer":"北条泰時","level":1,"mark":"blank"},{"text":"は"},{"id":"note:32:01:02","answer":"連署","level":1,"mark":"blank"},{"text":"（1225年）と"},{"id":"note:32:01:03","answer":"評定衆","level":1,"mark":"blank"},{"text":"（1225年）を整え、"},{"id":"note:32:01:04","answer":"御成敗式目","level":1,"mark":"blank"},{"text":"を"},{"id":"note:32:01:05","answer":"1232年","level":1,"mark":"blank"},{"text":"に制定した。別名は"},{"id":"note:32:01:06","answer":"貞永式目","level":1,"mark":"blank"},{"text":"で、"},{"id":"note:32:01:07","answer":"51か条","level":2,"mark":"underline"},{"text":"からなる。"}]},{"id":"note-p32-02","page":32,"tokens":[{"id":"note:32:02:01","answer":"北条時頼","level":1,"mark":"blank"},{"text":"は1247年の"},{"id":"note:32:02:02","answer":"宝治合戦","level":1,"mark":"blank"},{"text":"で三浦氏を滅ぼし、1249年に"},{"id":"note:32:02:03","answer":"引付衆","level":1,"mark":"blank"},{"text":"を置いた。1252年には"},{"id":"note:32:02:04","answer":"宗尊親王","level":1,"mark":"blank"},{"text":"を将軍に迎えた。"}]},{"id":"note-p32-03","page":32,"tokens":[{"text":"武士の土地支配では"},{"id":"note:32:03:01","answer":"惣領制","level":1,"mark":"blank"},{"text":"が基本となり、本家・分家は血縁を基盤に軍役を負担した。領地は"},{"id":"note:32:03:02","answer":"分割相続","level":1,"mark":"blank"},{"text":"が原則で、女性も相続の対象となった。"}]},{"id":"note-p32-04","page":32,"tokens":[{"text":"地頭の非法や荘園領主との争いは、"},{"id":"note:32:04:01","answer":"地頭請","level":1,"mark":"blank"},{"text":"や"},{"id":"note:32:04:02","answer":"下地中分","level":1,"mark":"blank"},{"text":"などによって調整された。"}]},{"id":"note-p32-05","page":32,"tokens":[{"text":"武士の生活では"},{"id":"note:32:05:01","answer":"弓馬の道","level":2,"mark":"underline"},{"text":"が重んじられ、"},{"id":"note:32:05:02","answer":"騎射三物","level":1,"mark":"blank"},{"text":"（"},{"id":"note:32:05:03","answer":"笠懸","level":2,"mark":"underline"},{"text":"・"},{"id":"note:32:05:04","answer":"犬追物","level":2,"mark":"underline"},{"text":"・"},{"id":"note:32:05:05","answer":"流鏑馬","level":2,"mark":"underline"},{"text":"）が行われた。"}]}]},{"id":"n04d","title":"元寇・経済と幕府の変化（p.33）","pageStart":33,"pageEnd":33,"paragraphs":[{"id":"note-p33-01","page":33,"tokens":[{"id":"note:33:01:01","answer":"フビライ","level":1,"mark":"blank"},{"text":"は"},{"id":"note:33:01:02","answer":"元","level":1,"mark":"blank"},{"text":"を建国し、朝貢を求めた。幕府の"},{"id":"note:33:01:03","answer":"北条時宗","level":1,"mark":"blank"},{"text":"は要求を拒み、元軍は"},{"id":"note:33:01:04","answer":"文永の役","level":1,"mark":"blank"},{"text":"（1274年）と"},{"id":"note:33:01:05","answer":"弘安の役","level":1,"mark":"blank"},{"text":"（1281年）に来襲した。"}]},{"id":"note-p33-02","page":33,"tokens":[{"id":"note:33:02:01","answer":"文永の役","level":1,"mark":"blank"},{"text":"では"},{"id":"note:33:02:02","answer":"対馬","level":2,"mark":"underline"},{"text":"・"},{"id":"note:33:02:03","answer":"壱岐","level":2,"mark":"underline"},{"text":"を経て博多湾へ上陸した。"},{"id":"note:33:02:04","answer":"弘安の役","level":1,"mark":"blank"},{"text":"に備えて"},{"id":"note:33:02:05","answer":"異国警固番役","level":1,"mark":"blank"},{"text":"や"},{"id":"note:33:02:06","answer":"石築地","level":1,"mark":"blank"},{"text":"の築造を進めた。"}]},{"id":"note-p33-03","page":33,"tokens":[{"text":"元寇後、幕府は"},{"id":"note:33:03:01","answer":"鎮西探題","level":1,"mark":"blank"},{"text":"を設置し、北条氏の"},{"id":"note:33:03:02","answer":"得宗","level":1,"mark":"blank"},{"text":"の権力が強まった。"},{"id":"note:33:03:03","answer":"霜月騒動","level":1,"mark":"blank"},{"text":"（1285年）では"},{"id":"note:33:03:04","answer":"平頼綱","level":1,"mark":"blank"},{"text":"が"},{"id":"note:33:03:05","answer":"安達泰盛","level":1,"mark":"blank"},{"text":"を滅ぼした。"}]},{"id":"note-p33-04","page":33,"tokens":[{"text":"鎌倉後期の農業では"},{"id":"note:33:04:01","answer":"二毛作","level":1,"mark":"blank"},{"text":"、"},{"id":"note:33:04:02","answer":"刈敷","level":1,"mark":"blank"},{"text":"・"},{"id":"note:33:04:03","answer":"草木灰","level":1,"mark":"blank"},{"text":"などの肥料が広がった。商業では"},{"id":"note:33:04:04","answer":"定期市","level":1,"mark":"blank"},{"text":"、"},{"id":"note:33:04:05","answer":"問丸","level":1,"mark":"blank"},{"text":"や"},{"id":"note:33:04:06","answer":"借上","level":1,"mark":"blank"},{"text":"が発達した。"}]},{"id":"note-p33-05","page":33,"tokens":[{"text":"土地相続の細分化や貨幣経済の発展で御家人は窮乏した。"},{"id":"note:33:05:01","answer":"永仁の徳政令","level":1,"mark":"blank"},{"text":"（1297年）は御家人所領の売却・質入れを制限し回復を図った。"}]},{"id":"note-p33-06","page":33,"tokens":[{"text":"荘園領主に反抗した武士などは"},{"id":"note:33:06:01","answer":"悪党","level":1,"mark":"blank"},{"text":"と呼ばれ、"},{"id":"note:33:06:02","answer":"得宗専制政治","level":2,"mark":"underline"},{"text":"への不満が高まった。"}]}]},{"id":"n04e","title":"鎌倉文化・新仏教（p.34）","pageStart":34,"pageEnd":34,"paragraphs":[{"id":"note-p34-01","page":34,"tokens":[{"id":"note:34:01:01","answer":"鎌倉文化","level":1,"mark":"blank"},{"text":"は武家の台頭を背景とする力強い表現、素朴さ、"},{"id":"note:34:01:02","answer":"宋・元文化","level":2,"mark":"underline"},{"text":"の影響が特徴である。"}]},{"id":"note-p34-02","page":34,"tokens":[{"id":"note:34:02:01","answer":"法然","level":1,"mark":"blank"},{"text":"は"},{"id":"note:34:02:02","answer":"浄土宗","level":1,"mark":"blank"},{"text":"を開き、"},{"id":"note:34:02:03","answer":"専修念仏","level":1,"mark":"blank"},{"text":"を説いた。著書は『"},{"id":"note:34:02:04","answer":"選択本願念仏集","level":1,"mark":"blank"},{"text":"』。"},{"id":"note:34:02:05","answer":"親鸞","level":1,"mark":"blank"},{"text":"は"},{"id":"note:34:02:06","answer":"浄土真宗","level":1,"mark":"blank"},{"text":"を広め、著書は『"},{"id":"note:34:02:07","answer":"教行信証","level":1,"mark":"blank"},{"text":"』。"}]},{"id":"note-p34-03","page":34,"tokens":[{"id":"note:34:03:01","answer":"一遍","level":1,"mark":"blank"},{"text":"は"},{"id":"note:34:03:02","answer":"時宗","level":1,"mark":"blank"},{"text":"を開き、"},{"id":"note:34:03:03","answer":"踊念仏","level":1,"mark":"blank"},{"text":"を広めた。"},{"id":"note:34:03:04","answer":"日蓮","level":1,"mark":"blank"},{"text":"は"},{"id":"note:34:03:05","answer":"日蓮宗","level":1,"mark":"blank"},{"text":"（法華宗）を開き、『"},{"id":"note:34:03:06","answer":"立正安国論","level":1,"mark":"blank"},{"text":"』を著した。"}]},{"id":"note-p34-04","page":34,"tokens":[{"text":"禅宗では"},{"id":"note:34:04:01","answer":"栄西","level":1,"mark":"blank"},{"text":"が"},{"id":"note:34:04:02","answer":"臨済宗","level":1,"mark":"blank"},{"text":"を伝え、『"},{"id":"note:34:04:03","answer":"興禅護国論","level":1,"mark":"blank"},{"text":"』を著した。"},{"id":"note:34:04:04","answer":"道元","level":1,"mark":"blank"},{"text":"は"},{"id":"note:34:04:05","answer":"曹洞宗","level":1,"mark":"blank"},{"text":"を伝え、『"},{"id":"note:34:04:06","answer":"正法眼蔵","level":1,"mark":"blank"},{"text":"』を残した。"}]},{"id":"note-p34-05","page":34,"tokens":[{"text":"旧仏教改革には"},{"id":"note:34:05:01","answer":"貞慶","level":1,"mark":"blank"},{"text":"（法相宗）、"},{"id":"note:34:05:02","answer":"明恵","level":1,"mark":"blank"},{"text":"（華厳宗）、"},{"id":"note:34:05:03","answer":"叡尊","level":1,"mark":"blank"},{"text":"（律宗）、"},{"id":"note:34:05:04","answer":"忍性","level":1,"mark":"blank"},{"text":"（律宗）らがある。"},{"id":"note:34:05:05","answer":"修験道","level":2,"mark":"underline"},{"text":"は山岳信仰と仏教の結びつきが基礎となる。"}]},{"id":"note-p34-06","page":34,"tokens":[{"text":"文学では『"},{"id":"note:34:06:01","answer":"新古今和歌集","level":1,"mark":"blank"},{"text":"』『"},{"id":"note:34:06:02","answer":"山家集","level":1,"mark":"blank"},{"text":"』、軍記の『"},{"id":"note:34:06:03","answer":"平家物語","level":1,"mark":"blank"},{"text":"』、随筆の『"},{"id":"note:34:06:04","answer":"方丈記","level":1,"mark":"blank"},{"text":"』『"},{"id":"note:34:06:05","answer":"徒然草","level":1,"mark":"blank"},{"text":"』が代表例である。"}]}]},{"id":"n04f","title":"鎌倉文化・学問と美術（p.35）","pageStart":35,"pageEnd":35,"paragraphs":[{"id":"note-p35-01","page":35,"tokens":[{"id":"note:35:01:01","answer":"有職故実","level":1,"mark":"blank"},{"text":"の研究では"},{"id":"note:35:01:02","answer":"禁秘抄","level":1,"mark":"blank"},{"text":"などが知られる。歴史書『"},{"id":"note:35:01:03","answer":"吾妻鏡","level":1,"mark":"blank"},{"text":"』は鎌倉幕府の記録で、『"},{"id":"note:35:01:04","answer":"愚管抄","level":1,"mark":"blank"},{"text":"』は"},{"id":"note:35:01:05","answer":"慈円","level":2,"mark":"underline"},{"text":"の著作である。"}]},{"id":"note-p35-02","page":35,"tokens":[{"text":"『"},{"id":"note:35:02:01","answer":"元亨釈書","level":1,"mark":"blank"},{"text":"』は"},{"id":"note:35:02:02","answer":"虎関師錬","level":2,"mark":"underline"},{"text":"による仏教史書、図書館としては"},{"id":"note:35:02:03","answer":"金沢文庫","level":1,"mark":"blank"},{"text":"を"},{"id":"note:35:02:04","answer":"北条実時","level":2,"mark":"underline"},{"text":"が設けた。"}]},{"id":"note-p35-03","page":35,"tokens":[{"text":"宋の影響を受けた建築には"},{"id":"note:35:03:01","answer":"東大寺南大門","level":1,"mark":"blank"},{"text":"に見られる"},{"id":"note:35:03:02","answer":"大仏様","level":1,"mark":"blank"},{"text":"、"},{"id":"note:35:03:03","answer":"円覚寺舎利殿","level":1,"mark":"blank"},{"text":"の"},{"id":"note:35:03:04","answer":"禅宗様","level":1,"mark":"blank"},{"text":"などがある。"},{"id":"note:35:03:05","answer":"和様","level":2,"mark":"underline"},{"text":"と折衷した"},{"id":"note:35:03:06","answer":"新和様","level":1,"mark":"blank"},{"text":"も生まれた。"}]},{"id":"note-p35-04","page":35,"tokens":[{"id":"note:35:04:01","answer":"運慶","level":1,"mark":"blank"},{"text":"・"},{"id":"note:35:04:02","answer":"快慶","level":1,"mark":"blank"},{"text":"らが活躍し、"},{"id":"note:35:04:03","answer":"東大寺南大門金剛力士像","level":1,"mark":"blank"},{"text":"には力強い"},{"id":"note:35:04:04","answer":"写実的表現","level":2,"mark":"underline"},{"text":"が見られる。"},{"id":"note:35:04:05","answer":"六波羅蜜寺空也上人像","level":1,"mark":"blank"},{"text":"は"},{"id":"note:35:04:06","answer":"康勝","level":1,"mark":"blank"},{"text":"の作である。"}]},{"id":"note-p35-05","page":35,"tokens":[{"text":"絵巻には『"},{"id":"note:35:05:01","answer":"北野天神縁起絵巻","level":1,"mark":"blank"},{"text":"』『"},{"id":"note:35:05:02","answer":"蒙古襲来絵詞","level":1,"mark":"blank"},{"text":"』『"},{"id":"note:35:05:03","answer":"春日権現験記絵","level":1,"mark":"blank"},{"text":"』がある。絵巻とともに"},{"id":"note:35:05:04","answer":"似絵","level":1,"mark":"blank"},{"text":"が盛んになった。"}]},{"id":"note-p35-06","page":35,"tokens":[{"text":"宋の書風を取り入れた"},{"id":"note:35:06:01","answer":"禅宗様","level":1,"mark":"blank"},{"text":"の書に加え、茶の湯・陶磁器・金属工芸にも独自の発展が見られた。"}]}]}]}]}